<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.OverlaysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:OverlaysViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="OverlaysPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Overlays are drawn on top of Roblox by DeadStrap's background process while the game is running. Changes apply the next time you launch Roblox." FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="Stats overlay" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

        <controls:OptionControl Header="Enable stats overlay" Description="Shows the selected stats in a corner of the Roblox window. It does not work over exclusive fullscreen.">
            <ui:ToggleSwitch IsChecked="{Binding OverlayEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="FPS" Description="Frames per second plus the 1% low over the last 5 seconds. Needs permission to read graphics events: run DeadStrap as administrator, or add your Windows user to the Performance Log Users group.">
            <ui:ToggleSwitch IsChecked="{Binding OverlayShowFps, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Frame time" Description="Average milliseconds per frame. Uses the same source as FPS.">
            <ui:ToggleSwitch IsChecked="{Binding OverlayShowFrameTime, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Ping" Description="Round trip to the game server address found in the Roblox log. Shows -- if the server does not answer pings.">
            <ui:ToggleSwitch IsChecked="{Binding OverlayShowPing, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="CPU" Description="Share of your total CPU used by Roblox.">
            <ui:ToggleSwitch IsChecked="{Binding OverlayShowCpu, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Memory" Description="Memory currently used by Roblox.">
            <ui:ToggleSwitch IsChecked="{Binding OverlayShowRam, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Clock" Description="Current local time.">
            <ui:ToggleSwitch IsChecked="{Binding OverlayShowClock, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Session timer" Description="How long this Roblox session has been running.">
            <ui:ToggleSwitch IsChecked="{Binding OverlayShowSessionTime, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Position" Description="Which corner of the game window the stats sit in.">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding Corners, Mode=OneTime}" SelectedItem="{Binding OverlayCorner, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl Header="Opacity" Description="How see-through the stats box is.">
            <Slider Width="200" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding OverlayOpacity, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Size" Description="Scale of the stats box.">
            <Slider Width="200" Minimum="0.75" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding OverlayScale, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Text="Crosshair overlay" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />

        <controls:OptionControl Header="Enable crosshair overlay" Description="Draws a crosshair in the middle of the Roblox window. Works without changing any game files.">
            <ui:ToggleSwitch IsChecked="{Binding CrosshairOverlayEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Crosshair style" Description="Which preset image to draw.">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding CrosshairTypes, Mode=OneTime}" SelectedItem="{Binding CrosshairOverlayType, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl Header="Crosshair size" Description="Multiplier on the image's own pixel size.">
            <Slider Width="200" Minimum="0.25" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding CrosshairOverlayScale, Mode=TwoWay}" />
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>
